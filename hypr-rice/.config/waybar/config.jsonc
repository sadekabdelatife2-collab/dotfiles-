{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,
    "modules-left": [],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "network", "battery"],

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "pulseaudio": {
        "format": "<span color='#8a8a8a'>vol</span> {volume}%",
        "format-muted": "<span color='#8a8a8a'>vol</span> off",
        "on-click": "pavucontrol",
        "tooltip": false
    },
    "network": {
        "format-wifi": "{icon} {essid}",
        "format-icons": ["▂", "▂▄", "▂▄▆", "▂▄▆█"],
        "format-ethernet": "wired",
        "format-disconnected": "offline",
        "on-click": "kitty -e nmtui",
        "tooltip-format": "{ifname}  {ipaddr}"
    },
    "battery": {
        "format": "<span color='#8a8a8a'>bat</span> {capacity}%",
        "format-charging": "<span color='#8a8a8a'>chg</span> {capacity}%",
        "states": { "warning": 30, "critical": 15 },
        "tooltip": false
    }
}
